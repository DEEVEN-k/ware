    subgraph cluster_legende { label=<<B>Légende</B>>; fontsize=15; style="rounded"; color="#8fa596"; margin=12;
        L_con [label=<Contributeur métier>, shape=box, style="filled", fillcolor="#EAF5EC", color="#00901D", fontcolor="#00370B"];
        L_cor [label=<Correspondant>, shape=box, style="filled", fillcolor="#00370B", color="#00370B", fontcolor="#ffffff"];
        L_rt [label=<Responsable de traitement>, shape=box, style="filled", fillcolor="#DCE9FB", color="#2A5DB0", fontcolor="#12305f"];
        L_adm [label=<Administrateur d&#x27;organisation>, shape=box, style="filled", fillcolor="#ECE1F7", color="#6B3FA0", fontcolor="#3b1f63"];
        L_cab [label=<Cabinet>, shape=box, style="filled", fillcolor="#FDEBD3", color="#C97A12", fontcolor="#6b3f05"];
        L_sys [label=<Système Waɖɛ>, shape=box, style="filled", fillcolor="#EEF0EF", color="#7b857e", fontcolor="#26302a"];
        L_aut [label=<Autorité de contrôle>, shape=box, style="filled,dashed", fillcolor="#ffffff", color="#555555", fontcolor="#333333"];
        L_dec [label=<Décision>, shape=diamond, style="filled", fillcolor="#FFF9E0", color="#B7791F", fontcolor="#5a3d0a"];
        L_con -> L_cor -> L_rt -> L_adm -> L_cab -> L_sys -> L_aut -> L_dec [style=invis];
    }
}