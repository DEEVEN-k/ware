digraph Flux {
    graph [rankdir=TB, fontname="DejaVu Sans", fontsize=24, labelloc=t, pad=0.4, nodesep=0.3, ranksep=0.45, newrank=true,
           label=<<B>Waɖɛ · Diagramme de flux complet</B>>];
    node [fontname="DejaVu Sans", fontsize=11, margin="0.14,0.08", penwidth=1.2];
    edge [fontname="DejaVu Sans", fontsize=10, color="#3f5a47", fontcolor="#00370B", arrowsize=0.8];
    subgraph cluster_P0 {
        label=<<B>0 · Mise en place</B>>; fontsize=17; fontcolor="#00370B"; style="rounded,filled"; fillcolor="#FAFCFA"; color="#8fa596"; margin=16;
        A1 [label=<Souscrire et créer l&#x27;espace<BR/>double authentification>, shape=box, style="filled", fillcolor="#ECE1F7", color="#6B3FA0", fontcolor="#3b1f63"];
        A2 [label=<Décrire l&#x27;organisation<BR/>secteur, effectif, nature publique,<BR/>mission de service public, pays>, shape=box, style="filled", fillcolor="#ECE1F7", color="#6B3FA0", fontcolor="#3b1f63"];
        A3 [label=<Renseigner la désignation légale<BR/>du correspondant ou délégué>, shape=box, style="filled", fillcolor="#ECE1F7", color="#6B3FA0", fontcolor="#3b1f63"];
        A4 [label=<Inviter les utilisateurs<BR/>rôles et périmètres de services>, shape=box, style="filled", fillcolor="#ECE1F7", color="#6B3FA0", fontcolor="#3b1f63"];
        A5 [label=<Recours à<BR/>un cabinet ?>, shape=diamond, style="filled", fillcolor="#FFF9E0", color="#B7791F", fontcolor="#5a3d0a"];
        A6 [label=<Demander un mandat<BR/>niveau, périmètre, durée>, shape=box, style="filled", fillcolor="#FDEBD3", color="#C97A12", fontcolor="#6b3f05"];
        A7 [label=<Mandat<BR/>accepté ?>, shape=diamond, style="filled", fillcolor="#FFF9E0", color="#B7791F", fontcolor="#5a3d0a"];
        A8 [label=<Mandat Actif<BR/>affectation nominative des consultants>, shape=box, style="filled", fillcolor="#FDEBD3", color="#C97A12", fontcolor="#6b3f05"];
        A9 [label=<Mandat Refusé>, shape=box, style="filled", fillcolor="#EEF0EF", color="#7b857e", fontcolor="#26302a"];
    }
    subgraph cluster_P1 {
        label=<<B>1 · Recensement des traitements</B>>; fontsize=17; fontcolor="#00370B"; style="rounded,filled"; fillcolor="#FAFCFA"; color="#8fa596"; margin=16;
        B1 [label=<Mode de<BR/>recensement>, shape=diamond, style="filled", fillcolor="#FFF9E0", color="#B7791F", fontcolor="#5a3d0a"];
        B2 [label=<Diagnostic guidé (F01)>, shape=box, style="filled", fillcolor="#EAF5EC", color="#00901D", fontcolor="#00370B"];
        B3 [label=<Import d&#x27;un registre existant>, shape=box, style="filled", fillcolor="#EAF5EC", color="#00901D", fontcolor="#00370B"];
        B4 [label=<Modèles sectoriels (F02)>, shape=box, style="filled", fillcolor="#EAF5EC", color="#00901D", fontcolor="#00370B"];
        B5 [label=<Trames de collecte (F04)<BR/>auprès des services métier>, shape=box, style="filled", fillcolor="#EAF5EC", color="#00901D", fontcolor="#00370B"];
        B6 [label=<Fiche au statut Brouillon<BR/>enregistrement automatique>, shape=box, style="filled", fillcolor="#EAF5EC", color="#00901D", fontcolor="#00370B"];
        B7 [label=<Saisie des 3 blocs de la fiche<BR/>aide contextuelle par bulles>, shape=box, style="filled", fillcolor="#EAF5EC", color="#00901D", fontcolor="#00370B"];
        B8 [label=<Qualification provisoire en direct<BR/>régime, motifs, besoin d&#x27;AIPD>, shape=box, style="filled", fillcolor="#EEF0EF", color="#7b857e", fontcolor="#26302a"];
        B9 [label=<Soumettre à qualification>, shape=box, style="filled", fillcolor="#EAF5EC", color="#00901D", fontcolor="#00370B"];
        B10 [label=<Champs obligatoires<BR/>complets ?>, shape=diamond, style="filled", fillcolor="#FFF9E0", color="#B7791F", fontcolor="#5a3d0a"];
        B11 [label=<Fiche incomplète (AL-05)<BR/>liste des champs manquants>, shape=box, style="filled", fillcolor="#EEF0EF", color="#7b857e", fontcolor="#26302a"];
        B12 [label=<Soumise à qualification<BR/>notification au correspondant>, shape=box, style="filled", fillcolor="#EEF0EF", color="#7b857e", fontcolor="#26302a"];
    }
    subgraph cluster_P2 {
        label=<<B>2 · Qualification et publication</B>>; fontsize=17; fontcolor="#00370B"; style="rounded,filled"; fillcolor="#FAFCFA"; color="#8fa596"; margin=16;
        C1 [label=<Exécuter le logigramme<BR/>de chaque juridiction de la fiche>, shape=box, style="filled", fillcolor="#EEF0EF", color="#7b857e", fontcolor="#26302a"];
        C2 [label=<Résultat : régime, motifs, fondement,<BR/>version du référentiel, feuille de route,<BR/>réserve d&#x27;interprétation (D05)>, shape=box, style="filled", fillcolor="#EEF0EF", color="#7b857e", fontcolor="#26302a"];
        C3 [label=<Le correspondant<BR/>retient le régime<BR/>du moteur ?>, shape=diamond, style="filled", fillcolor="#FFF9E0", color="#B7791F", fontcolor="#5a3d0a"];
        C4 [label=<Retenir un autre régime<BR/>motif obligatoire>, shape=box, style="filled", fillcolor="#00370B", color="#00370B", fontcolor="#ffffff"];
        C5 [label=<Tâche : consulter l&#x27;autorité<BR/>(BJ-T3, le doute oblige)>, shape=box, style="filled", fillcolor="#EEF0EF", color="#7b857e", fontcolor="#26302a"];
        C6 [label=<Fiche à<BR/>compléter ?>, shape=diamond, style="filled", fillcolor="#FFF9E0", color="#B7791F", fontcolor="#5a3d0a"];
        C7 [label=<Renvoi au contributeur<BR/>avec motif>, shape=box, style="filled", fillcolor="#00370B", color="#00370B", fontcolor="#ffffff"];
        C8 [label=<Fiche Qualifiée<BR/>qualification figée et journalisée>, shape=box, style="filled", fillcolor="#00370B", color="#00370B", fontcolor="#ffffff"];
        C9 [label=<AIPD<BR/>requise ?>, shape=diamond, style="filled", fillcolor="#FFF9E0", color="#B7791F", fontcolor="#5a3d0a"];
        C10 [label=<Visa activé par<BR/>l&#x27;organisation ?>, shape=diamond, style="filled", fillcolor="#FFF9E0", color="#B7791F", fontcolor="#5a3d0a"];
        C11 [label=<Viser la fiche>, shape=box, style="filled", fillcolor="#DCE9FB", color="#2A5DB0", fontcolor="#12305f"];
        C12 [label=<Publier au registre>, shape=box, style="filled", fillcolor="#00370B", color="#00370B", fontcolor="#ffffff"];
        C13 [label=<Publiée au registre<BR/>instantané de version, indice recalculé,<BR/>revue planifiée (12 ou 6 mois)>, shape=box, style="filled", fillcolor="#EEF0EF", color="#7b857e", fontcolor="#26302a"];
    }
    subgraph cluster_P3 {
        label=<<B>3 · Analyse d&#x27;impact</B>>; fontsize=17; fontcolor="#00370B"; style="rounded,filled"; fillcolor="#FAFCFA"; color="#8fa596"; margin=16;
        D1 [label=<AIPD « À réaliser »<BR/>alerte AL-02>, shape=box, style="filled", fillcolor="#EEF0EF", color="#7b857e", fontcolor="#26302a"];
        D2 [label=<Lancer l&#x27;analyse<BR/>inviter des contributeurs>, shape=box, style="filled", fillcolor="#00370B", color="#00370B", fontcolor="#ffffff"];
        D3 [label=<Remplir les 4 sections :<BR/>description, nécessité et proportionnalité,<BR/>risques, mesures>, shape=box, style="filled", fillcolor="#EAF5EC", color="#00901D", fontcolor="#00370B"];
        D4 [label=<Coter les risques<BR/>gravité × vraisemblance,<BR/>initial puis résiduel>, shape=box, style="filled", fillcolor="#00370B", color="#00370B", fontcolor="#ffffff"];
        D5 [label=<Soumettre à validation>, shape=box, style="filled", fillcolor="#00370B", color="#00370B", fontcolor="#ffffff"];
        D6 [label=<Analyse<BR/>validée ?>, shape=diamond, style="filled", fillcolor="#FFF9E0", color="#B7791F", fontcolor="#5a3d0a"];
        D7 [label=<AIPD Validée<BR/>rapport E04 généré>, shape=box, style="filled", fillcolor="#00370B", color="#00370B", fontcolor="#ffffff"];
        D8 [label=<Risque résiduel élevé ?<BR/>(Bénin, art. 429)>, shape=diamond, style="filled", fillcolor="#FFF9E0", color="#B7791F", fontcolor="#5a3d0a"];
        D9 [label=<Dossier de consultation préalable<BR/>délai de 8 semaines, prorogeable de 6>, shape=box, style="filled", fillcolor="#EEF0EF", color="#7b857e", fontcolor="#26302a"];
    }
    subgraph cluster_P4 {
        label=<<B>4 · Formalité auprès de l&#x27;autorité</B>>; fontsize=17; fontcolor="#00370B"; style="rounded,filled"; fillcolor="#FAFCFA"; color="#8fa596"; margin=16;
        E1 [label=<Le régime est-il<BR/>une formalité ?>, shape=diamond, style="filled", fillcolor="#FFF9E0", color="#B7791F", fontcolor="#5a3d0a"];
        E2 [label=<Dispense ou exclusion<BR/>documentée au registre>, shape=box, style="filled", fillcolor="#EEF0EF", color="#7b857e", fontcolor="#26302a"];
        E3 [label=<Créer le dossier<BR/>prérempli depuis la fiche>, shape=box, style="filled", fillcolor="#00370B", color="#00370B", fontcolor="#ffffff"];
        E4 [label=<Générer les documents (E03)<BR/>modèle de la juridiction, Word et PDF>, shape=box, style="filled", fillcolor="#EEF0EF", color="#7b857e", fontcolor="#26302a"];
        E5 [label=<Compléter les pièces<BR/>selon la feuille de route>, shape=box, style="filled", fillcolor="#00370B", color="#00370B", fontcolor="#ffffff"];
        E6 [label=<Valider : dossier prêt<BR/>à être transmis>, shape=box, style="filled", fillcolor="#00370B", color="#00370B", fontcolor="#ffffff"];
        E7 [label=<Déposer auprès de l&#x27;autorité<BR/>voie électronique, postale ou guichet>, shape=box, style="filled", fillcolor="#00370B", color="#00370B", fontcolor="#ffffff"];
        E8 [label=<Dossier Envoyé<BR/>échéance d&#x27;instruction calculée>, shape=box, style="filled", fillcolor="#EEF0EF", color="#7b857e", fontcolor="#26302a"];
        E9 [label=<Instruction du dossier>, shape=box, style="filled,dashed", fillcolor="#ffffff", color="#555555", fontcolor="#333333"];
        E10 [label=<Suite donnée<BR/>par l&#x27;autorité ?>, shape=diamond, style="filled", fillcolor="#FFF9E0", color="#B7791F", fontcolor="#5a3d0a"];
        E11 [label=<Observations reçues<BR/>répondre à l&#x27;autorité>, shape=box, style="filled", fillcolor="#00370B", color="#00370B", fontcolor="#ffffff"];
        E12 [label=<Dossier Accepté<BR/>récépissé ou décision enregistrés>, shape=box, style="filled", fillcolor="#00370B", color="#00370B", fontcolor="#ffffff"];
        E13 [label=<Dossier Rejeté<BR/>À régulariser>, shape=box, style="filled", fillcolor="#00370B", color="#00370B", fontcolor="#ffffff"];
        E14 [label=<Silence vaut<BR/>acceptation ?>, shape=diamond, style="filled", fillcolor="#FFF9E0", color="#B7791F", fontcolor="#5a3d0a"];
        E15 [label=<Acceptation tacite<BR/>(Bénin)>, shape=box, style="filled", fillcolor="#EEF0EF", color="#7b857e", fontcolor="#26302a"];
        E16 [label=<Dossier déposé sans suite (AL-04)<BR/>relancer l&#x27;autorité (Togo)>, shape=box, style="filled", fillcolor="#EEF0EF", color="#7b857e", fontcolor="#26302a"];
        E17 [label=<Validité limitée ?<BR/>(Bénin : 2 ans)>, shape=diamond, style="filled", fillcolor="#FFF9E0", color="#B7791F", fontcolor="#5a3d0a"];
        E18 [label=<Décision arrivant à expiration (AL-12)<BR/>J-60 puis J-15>, shape=box, style="filled", fillcolor="#EEF0EF", color="#7b857e", fontcolor="#26302a"];
        E19 [label=<Dossier de renouvellement>, shape=box, style="filled", fillcolor="#00370B", color="#00370B", fontcolor="#ffffff"];
        E20 [label=<Formalité qualifiée non déposée (AL-03)<BR/>30 jours après la qualification>, shape=box, style="filled", fillcolor="#EEF0EF", color="#7b857e", fontcolor="#26302a"];
    }
    subgraph cluster_P5 {
        label=<<B>5 · Pilotage continu</B>>; fontsize=17; fontcolor="#00370B"; style="rounded,filled"; fillcolor="#FAFCFA"; color="#8fa596"; margin=16;
        F1 [label=<Tableau de bord<BR/>indice de conformité,<BR/>prochaine action prioritaire>, shape=box, style="filled", fillcolor="#EEF0EF", color="#7b857e", fontcolor="#26302a"];
        F2 [label=<Tâches et alertes<BR/>rappels, tâche en retard (AL-11)>, shape=box, style="filled", fillcolor="#EEF0EF", color="#7b857e", fontcolor="#26302a"];
        F3 [label=<Journal de conformité<BR/>chaque action horodatée et chaînée>, shape=box, style="filled", fillcolor="#EEF0EF", color="#7b857e", fontcolor="#26302a"];
        F4 [label=<Événement<BR/>de révision ?>, shape=diamond, style="filled", fillcolor="#FFF9E0", color="#B7791F", fontcolor="#5a3d0a"];
        F5 [label=<Échéance de revue<BR/>périodique (AL-08)>, shape=box, style="filled", fillcolor="#EEF0EF", color="#7b857e", fontcolor="#26302a"];
        F6 [label=<Modification substantielle<BR/>d&#x27;une fiche publiée>, shape=box, style="filled", fillcolor="#EAF5EC", color="#00901D", fontcolor="#00370B"];
        F7 [label=<Nouvelle version<BR/>du référentiel (AL-09)>, shape=box, style="filled", fillcolor="#EEF0EF", color="#7b857e", fontcolor="#26302a"];
        F8 [label=<Fiche « À réviser »>, shape=box, style="filled", fillcolor="#EEF0EF", color="#7b857e", fontcolor="#26302a"];
        F9 [label=<Fiche déjà déclarée<BR/>et modification<BR/>substantielle ?>, shape=diamond, style="filled", fillcolor="#FFF9E0", color="#B7791F", fontcolor="#5a3d0a"];
        F10 [label=<Nouvelle déclaration requise<BR/>(AL-13, BJ-T4)>, shape=box, style="filled", fillcolor="#EEF0EF", color="#7b857e", fontcolor="#26302a"];
        F11 [label=<Contrôles permanents :<BR/>sous-traitant sans contrat (AL-06),<BR/>transfert non encadré (AL-07),<BR/>mandat à échéance (AL-10)>, shape=box, style="filled", fillcolor="#EEF0EF", color="#7b857e", fontcolor="#26302a"];
    }
    subgraph cluster_P6 {
        label=<<B>6 · Violation de données</B>>; fontsize=17; fontcolor="#00370B"; style="rounded,filled"; fillcolor="#FAFCFA"; color="#8fa596"; margin=16;
        G0 [label=<Incident constaté>, shape=box, style="filled,rounded", fillcolor="#EAF5EC", color="#00901D", fontcolor="#00370B"];
        G1 [label=<Déclarer la violation<BR/>y compris sur mobile,<BR/>date de prise de connaissance>, shape=box, style="filled", fillcolor="#EAF5EC", color="#00901D", fontcolor="#00370B"];
        G2 [label=<Échéance = connaissance + 72 h<BR/>alerte AL-01, rappels à 25, 50, 75 et 90 %>, shape=box, style="filled", fillcolor="#EEF0EF", color="#7b857e", fontcolor="#26302a"];
        G3 [label=<V1 : risque pour les droits<BR/>et libertés ?>, shape=diamond, style="filled", fillcolor="#FFF9E0", color="#B7791F", fontcolor="#5a3d0a"];
        G4 [label=<Non notifiable<BR/>consignée au registre interne>, shape=box, style="filled", fillcolor="#00370B", color="#00370B", fontcolor="#ffffff"];
        G5 [label=<V2 : risque<BR/>élevé ?>, shape=diamond, style="filled", fillcolor="#FFF9E0", color="#B7791F", fontcolor="#5a3d0a"];
        G6 [label=<Notifier l&#x27;autorité<BR/>formulaire E05 ou officiel>, shape=box, style="filled", fillcolor="#00370B", color="#00370B", fontcolor="#ffffff"];
        G7 [label=<Notifier l&#x27;autorité<BR/>et informer les personnes concernées>, shape=box, style="filled", fillcolor="#00370B", color="#00370B", fontcolor="#ffffff"];
        G8 [label=<Violation Notifiée<BR/>rappels annulés>, shape=box, style="filled", fillcolor="#EEF0EF", color="#7b857e", fontcolor="#26302a"];
        G9 [label=<Mesures correctives<BR/>En cours de traitement>, shape=box, style="filled", fillcolor="#00370B", color="#00370B", fontcolor="#ffffff"];
        G10 [label=<Résolue, puis Close et archivée>, shape=box, style="filled", fillcolor="#00370B", color="#00370B", fontcolor="#ffffff"];
    }
    START [label=<Début : une organisation rejoint Waɖɛ>, shape=box, style="filled,rounded", fillcolor="#EAF5EC", color="#00901D", fontcolor="#00370B"];
    FIN [label=<Conformité pilotée dans la durée>, shape=box, style="filled,rounded", fillcolor="#EAF5EC", color="#00901D", fontcolor="#00370B"];
