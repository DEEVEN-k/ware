digraph Phase {
  graph [rankdir=LR, newrank=true, fontname="DejaVu Sans", pad=0.35, nodesep=0.3, ranksep=0.4, forcelabels=true, bgcolor="white", labelloc=t, labeljust=l, fontsize=22,
         label=<<B>6 · Violation de données</B>  <FONT POINT-SIZE="12" COLOR="#5b6b5f">Waɖɛ · diagramme d'activité UML · couloirs horizontaux, lecture de gauche à droite</FONT>>];
  node [fontname="DejaVu Sans", fontsize=11, margin="0.12,0.06", penwidth=1.2];
  edge [fontname="DejaVu Sans", fontsize=9, color="#3f5a47", fontcolor="#00370B", arrowsize=0.75];
  subgraph cluster_CON { label=<<B>Contributeur métier</B>>; fontsize=14; fontcolor="#00901D"; style="filled"; fillcolor="#EAF5EC"; color="#00901D"; penwidth=1.3; margin=14;
    H_CON [shape=point, width=0.01, style=invis];
    G0 [shape=larrow, style=filled, fillcolor="#E4F1F4", color="#0E5F73", label=<Incident constaté>];
    G1 [shape=box, style="rounded,filled", fillcolor="white", color="#00901D", label=<Déclarer la violation<BR/>(y compris sur mobile)>];
  }
  subgraph cluster_COR { label=<<B>Correspondant</B>>; fontsize=14; fontcolor="#00370B"; style="filled"; fillcolor="#E6F0E8"; color="#00370B"; penwidth=1.3; margin=14;
    H_COR [shape=point, width=0.01, style=invis];
    G3 [shape=diamond, style=filled, fillcolor="white", color="#00370B", width=0.42, height=0.42, fixedsize=true, label=""];
    G4 [shape=box, style="rounded,filled", fillcolor="white", color="#00370B", label=<Consigner au<BR/>registre interne>];
    G5 [shape=diamond, style=filled, fillcolor="white", color="#00370B", width=0.42, height=0.42, fixedsize=true, label=""];
    G6 [shape=cds, style=filled, fillcolor="#FFF6E0", color="#B7791F", label=<Notifier l&#x27;autorité<BR/>(E05)>];
    FG2 [shape=box, style=filled, fillcolor="#12180E", color="#12180E", width=1.7, height=0.07, fixedsize=true, label=""];
    G6B [shape=cds, style=filled, fillcolor="#FFF6E0", color="#B7791F", label=<Notifier l&#x27;autorité>];
    G7 [shape=cds, style=filled, fillcolor="#FFF6E0", color="#B7791F", label=<Informer les personnes<BR/>concernées>];
    JG [shape=box, style=filled, fillcolor="#12180E", color="#12180E", width=1.7, height=0.07, fixedsize=true, label=""];
    MG [shape=diamond, style=filled, fillcolor="white", color="#00370B", width=0.42, height=0.42, fixedsize=true, label=""];
    G9 [shape=box, style="rounded,filled", fillcolor="white", color="#00370B", label=<Mettre en œuvre les<BR/>mesures correctives>];
    G10 [shape=box, style="rounded,filled", fillcolor="white", color="#00370B", label=<Clore la violation>];
  }
  subgraph cluster_SYS { label=<<B>Système Waɖɛ</B>>; fontsize=14; fontcolor="#7b857e"; style="filled"; fillcolor="#F1F3F2"; color="#7b857e"; penwidth=1.3; margin=14;
    H_SYS [shape=point, width=0.01, style=invis];
    G2 [shape=box, style="rounded,filled", fillcolor="white", color="#7b857e", label=<Fixer l&#x27;échéance<BR/>à 72 heures>];
    FG [shape=box, style=filled, fillcolor="#12180E", color="#12180E", width=1.7, height=0.07, fixedsize=true, label=""];
    G2A [shape=cds, style=filled, fillcolor="#FFF6E0", color="#B7791F", label=<AL-01 au<BR/>correspondant>];
    T5 [shape=invtriangle, style=filled, fillcolor="#FFF9E0", color="#B7791F", width=0.42, height=0.36, fixedsize=true, label="", xlabel=<25, 50, 75 et 90 %<BR/>du délai>];
    G2B [shape=cds, style=filled, fillcolor="#FFF6E0", color="#B7791F", label=<Rappels tant que<BR/>non notifiée>];
    X2 [shape=circle, style=filled, fillcolor="white", color="#12180E", width=0.3, fixedsize=true, fontsize=14, label="×"];
    G11 [shape=box, style="rounded,filled", fillcolor="white", color="#7b857e", label=<Mettre à jour l&#x27;indice<BR/>(traitement des violations)>];
    FIN2 [shape=doublecircle, style=filled, fillcolor="#12180E", color="#12180E", width=0.24, fixedsize=true, label=""];
  }
  subgraph cluster_AUT { label=<<B>Autorité de contrôle (IPDCP, APDP)</B>>; fontsize=14; fontcolor="#555555"; style="filled"; fillcolor="#FFFFFF"; color="#555555"; penwidth=1.3; margin=14;
    H_AUT [shape=point, width=0.01, style=invis];
    GA [shape=larrow, style=filled, fillcolor="#E4F1F4", color="#0E5F73", label=<Recevoir la<BR/>notification>];
  }
  H_CON -> G0 [style=invis];
  H_COR -> G3 [style=invis];
  H_SYS -> G2 [style=invis];
  H_AUT -> GA [style=invis];
  G0 -> G1 [];
  G1 -> G2 [];
  G2 -> FG [];
  FG -> G2A [];
  FG -> T5 [];
  FG -> G3 [];
  T5 -> G2B [];
  G2B -> X2 [];
  G2A -> G3 [style=dashed, color="#B7791F"];
  G3 -> G4 [label=<[V1 : aucun risque]>];
  G3 -> G5 [label=<[V1 : risque]>];
  G5 -> G6 [label=<[V2 : risque non élevé]>];
  G5 -> FG2 [label=<[V2 : risque élevé]>];
  FG2 -> G6B [];
  FG2 -> G7 [];
  G6B -> JG [];
  G7 -> JG [];
  G6 -> GA [style=dashed, color="#B7791F"];
  G6B -> GA [style=dashed, color="#B7791F"];
  G4 -> MG [];
  G6 -> MG [];
  JG -> MG [];
  MG -> G9 [];
  G9 -> G10 [];
  G10 -> G11 [];
  G11 -> FIN2 [];
}