digraph Phase {
  graph [rankdir=LR, newrank=true, fontname="DejaVu Sans", pad=0.35, nodesep=0.3, ranksep=0.4, forcelabels=true, bgcolor="white", labelloc=t, labeljust=l, fontsize=22,
         label=<<B>4 · Formalité</B>  <FONT POINT-SIZE="12" COLOR="#5b6b5f">Waɖɛ · diagramme d'activité UML · couloirs horizontaux, lecture de gauche à droite</FONT>>];
  node [fontname="DejaVu Sans", fontsize=11, margin="0.12,0.06", penwidth=1.2];
  edge [fontname="DejaVu Sans", fontsize=9, color="#3f5a47", fontcolor="#00370B", arrowsize=0.75];
  subgraph cluster_COR { label=<<B>Correspondant</B>>; fontsize=14; fontcolor="#00370B"; style="filled"; fillcolor="#E6F0E8"; color="#00370B"; penwidth=1.3; margin=14;
    H_COR [shape=point, width=0.01, style=invis];
    E3 [shape=box, style="rounded,filled", fillcolor="white", color="#00370B", label=<Créer le dossier<BR/>prérempli>];
    E5 [shape=box, style="rounded,filled", fillcolor="white", color="#00370B", label=<Joindre les pièces<BR/>de la feuille de route>];
    E6 [shape=box, style="rounded,filled", fillcolor="white", color="#00370B", label=<Valider le dossier>];
    E7 [shape=cds, style=filled, fillcolor="#FFF6E0", color="#B7791F", label=<Déposer auprès<BR/>de l&#x27;autorité>];
    E11 [shape=box, style="rounded,filled", fillcolor="white", color="#00370B", label=<Répondre aux<BR/>observations>];
    E13 [shape=box, style="rounded,filled", fillcolor="white", color="#00370B", label=<Régulariser<BR/>le dossier>];
    E12 [shape=larrow, style=filled, fillcolor="#E4F1F4", color="#0E5F73", label=<Enregistrer récépissé<BR/>ou décision>];
    E16R [shape=box, style="rounded,filled", fillcolor="white", color="#00370B", label=<Relancer l&#x27;autorité>];
    E19 [shape=box, style="rounded,filled", fillcolor="white", color="#00370B", label=<Préparer le<BR/>renouvellement>];
    DEPUIS_P6 [shape=circle, style=filled, fillcolor="#EAF5EC", color="#00901D", fixedsize=true, width=0.32, label="", xlabel=<<FONT COLOR="#00370B" POINT-SIZE="10"><B>depuis phase 5 · P6</B></FONT>>];
  }
  subgraph cluster_SYS { label=<<B>Système Waɖɛ</B>>; fontsize=14; fontcolor="#7b857e"; style="filled"; fillcolor="#F1F3F2"; color="#7b857e"; penwidth=1.3; margin=14;
    H_SYS [shape=point, width=0.01, style=invis];
    E1 [shape=diamond, style=filled, fillcolor="white", color="#7b857e", width=0.42, height=0.42, fixedsize=true, label=""];
    E2 [shape=box, style="rounded,filled", fillcolor="white", color="#7b857e", label=<Documenter la dispense<BR/>au registre>];
    E4 [shape=box, style="rounded,filled", fillcolor="white", color="#7b857e", label=<Générer les documents<BR/>(E03)>];
    T1 [shape=invtriangle, style=filled, fillcolor="#FFF9E0", color="#B7791F", width=0.42, height=0.36, fixedsize=true, label="", xlabel=<30 jours sans dépôt>];
    E20 [shape=cds, style=filled, fillcolor="#FFF6E0", color="#B7791F", label=<AL-03 : formalité<BR/>non déposée>];
    X1 [shape=circle, style=filled, fillcolor="white", color="#12180E", width=0.3, fixedsize=true, fontsize=14, label="×"];
    E8 [shape=box, style="rounded,filled", fillcolor="white", color="#7b857e", label=<Enregistrer le dépôt,<BR/>calculer l&#x27;échéance>];
    T2 [shape=invtriangle, style=filled, fillcolor="#FFF9E0", color="#B7791F", width=0.42, height=0.36, fixedsize=true, label="", xlabel=<Échéance d&#x27;instruction<BR/>atteinte>];
    E14 [shape=diamond, style=filled, fillcolor="white", color="#7b857e", width=0.42, height=0.42, fixedsize=true, label=""];
    E15 [shape=box, style="rounded,filled", fillcolor="white", color="#7b857e", label=<Passer en<BR/>Acceptation tacite>];
    E16 [shape=cds, style=filled, fillcolor="#FFF6E0", color="#B7791F", label=<AL-04 : dossier<BR/>sans suite (+15 j)>];
    ME [shape=diamond, style=filled, fillcolor="white", color="#7b857e", width=0.42, height=0.42, fixedsize=true, label=""];
    E17 [shape=diamond, style=filled, fillcolor="white", color="#7b857e", width=0.42, height=0.42, fixedsize=true, label=""];
    T3 [shape=invtriangle, style=filled, fillcolor="#FFF9E0", color="#B7791F", width=0.42, height=0.36, fixedsize=true, label="", xlabel=<J-60 puis J-15<BR/>avant expiration>];
    E18 [shape=cds, style=filled, fillcolor="#FFF6E0", color="#B7791F", label=<AL-12 : décision<BR/>à renouveler>];
    DEPUIS_F2 [shape=circle, style=filled, fillcolor="#EAF5EC", color="#00901D", fixedsize=true, width=0.32, label="", xlabel=<<FONT COLOR="#00370B" POINT-SIZE="10"><B>depuis phase 2 · F2</B></FONT>>];
    VERS_MF [shape=circle, style=filled, fillcolor="#EAF5EC", color="#00901D", fixedsize=true, width=0.32, label="", xlabel=<<FONT COLOR="#00370B" POINT-SIZE="10"><B>vers phase 5 · MF</B></FONT>>];
  }
  subgraph cluster_AUT { label=<<B>Autorité de contrôle (IPDCP, APDP)</B>>; fontsize=14; fontcolor="#555555"; style="filled"; fillcolor="#FFFFFF"; color="#555555"; penwidth=1.3; margin=14;
    H_AUT [shape=point, width=0.01, style=invis];
    E9 [shape=box, style="rounded,filled", fillcolor="white", color="#555555", label=<Instruire le dossier>];
    E10 [shape=diamond, style=filled, fillcolor="white", color="#555555", width=0.42, height=0.42, fixedsize=true, label=""];
  }
  H_COR -> E3 [style=invis];
  H_SYS -> E1 [style=invis];
  H_AUT -> E9 [style=invis];
  DEPUIS_F2 -> E1 [];
  E1 -> E2 [label=<[dispense ou exclusion]>];
  E1 -> E3 [label=<[formalité due]>];
  E2 -> VERS_MF [];
  E3 -> E4 [];
  E4 -> E5 [];
  E5 -> E6 [];
  E3 -> T1 [style=dashed, color="#B7791F"];
  T1 -> E20 [];
  E20 -> X1 [];
  E6 -> E7 [];
  E7 -> E8 [];
  E8 -> E9 [];
  E9 -> E10 [];
  E10 -> E11 [label=<[observations]>];
  E11 -> E9 [];
  E10 -> E13 [label=<[rejet]>];
  E13 -> E5 [];
  E10 -> E12 [label=<[acceptation]>];
  E12 -> ME [];
  E10 -> T2 [label=<[pas de réponse]>];
  T2 -> E14 [];
  E14 -> E15 [label=<[silence vaut acceptation<BR/>(Bénin)]>];
  E15 -> ME [];
  E14 -> E16 [label=<[sans effet (Togo)]>];
  E16 -> E16R [];
  E16R -> E9 [];
  ME -> E17 [];
  E17 -> T3 [label=<[validité limitée<BR/>(Bénin : 2 ans)]>];
  T3 -> E18 [];
  E18 -> E19 [];
  E19 -> E3 [];
  E17 -> VERS_MF [label=<[sans limite]>];
  DEPUIS_P6 -> E3 [];
}