digraph Wade {
    graph [rankdir=LR, fontname="DejaVu Sans", fontsize=22, labelloc=t, pad=0.4, nodesep=0.35, ranksep=1.1,
           splines=true, compound=true, newrank=true,
           label=<<B>Waɖɛ · Diagramme de classes complet</B>>];
    node [shape=plain, fontname="DejaVu Sans", fontsize=10];
    edge [fontname="DejaVu Sans", fontsize=9, color="#3f5a47", fontcolor="#3f5a47", arrowsize=0.8, labeldistance=1.6];
    subgraph cluster_Acces {
        label=<<B>Accès : organisations, cabinets, utilisateurs, mandats</B>>; fontsize=16; fontcolor="#00370B";
        style="rounded,filled"; fillcolor="#F3ECFA"; color="#8fa596"; margin=18;
        Utilisateur [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#00370B"><FONT COLOR="white"><B>Utilisateur</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+Guid Id<BR ALIGN="LEFT"/>+string Courriel<BR ALIGN="LEFT"/>+string NomComplet<BR ALIGN="LEFT"/>+bool DoubleAuthActive<BR ALIGN="LEFT"/>+bool Actif<BR ALIGN="LEFT"/>+DateTimeOffset? DerniereConnexion<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
        Organisation [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#00370B"><FONT COLOR="white"><B>Organisation</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+Guid Id<BR ALIGN="LEFT"/>+string Denomination<BR ALIGN="LEFT"/>+string FormeJuridique<BR ALIGN="LEFT"/>+string IdentifiantFiscal<BR ALIGN="LEFT"/>+string Rccm<BR ALIGN="LEFT"/>+string Adresse<BR ALIGN="LEFT"/>+string Secteur<BR ALIGN="LEFT"/>+string TrancheEffectif<BR ALIGN="LEFT"/>+string PaysEtablissement<BR ALIGN="LEFT"/>+bool NaturePublique<BR ALIGN="LEFT"/>+bool MissionServicePublic<BR ALIGN="LEFT"/>+bool VisaActive<BR ALIGN="LEFT"/>+bool CircuitFusionne<BR ALIGN="LEFT"/>+Guid? GroupeParentId<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
        ServiceDirection [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#00370B"><FONT COLOR="white"><B>ServiceDirection</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+Guid Id<BR ALIGN="LEFT"/>+string Libelle<BR ALIGN="LEFT"/>+Guid? ParentId<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
        MembreOrganisation [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#00370B"><FONT COLOR="white"><B>MembreOrganisation</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+Guid UtilisateurId<BR ALIGN="LEFT"/>+Guid OrganisationId<BR ALIGN="LEFT"/>+Set&lt;RoleOrganisation&gt; Roles<BR ALIGN="LEFT"/>+List&lt;Guid&gt; PerimetreServices<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
        RoleOrganisation [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#5b6b5f"><FONT COLOR="white"><FONT POINT-SIZE="9">&lt;&lt;enumeration&gt;&gt;</FONT><BR/><B>RoleOrganisation</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">AdministrateurOrganisation<BR ALIGN="LEFT"/>Correspondant<BR ALIGN="LEFT"/>ResponsableTraitement<BR ALIGN="LEFT"/>ContributeurMetier<BR ALIGN="LEFT"/>LecteurAuditeur<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
        ResponsableTraitementLegal [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#00370B"><FONT COLOR="white"><B>ResponsableTraitementLegal</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+string Nom<BR ALIGN="LEFT"/>+string Fonction<BR ALIGN="LEFT"/>+string Adresse<BR ALIGN="LEFT"/>+string Telephone<BR ALIGN="LEFT"/>+string Courriel<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
        DesignationCorrespondant [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#00370B"><FONT COLOR="white"><B>DesignationCorrespondant</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+bool Designe<BR ALIGN="LEFT"/>+string Nom<BR ALIGN="LEFT"/>+string Fonction<BR ALIGN="LEFT"/>+StatutCorrespondant Statut<BR ALIGN="LEFT"/>+DateOnly? DateDesignation<BR ALIGN="LEFT"/>+Guid? JustificatifId<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
        Cabinet [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#00370B"><FONT COLOR="white"><B>Cabinet</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+Guid Id<BR ALIGN="LEFT"/>+string Denomination<BR ALIGN="LEFT"/>+Guid OrganisationPropreId<BR ALIGN="LEFT"/>+bool AccesDossierPropreOuvert<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
        MembreCabinet [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#00370B"><FONT COLOR="white"><B>MembreCabinet</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+Guid UtilisateurId<BR ALIGN="LEFT"/>+Guid CabinetId<BR ALIGN="LEFT"/>+RoleCabinet Role<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
        RoleCabinet [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#5b6b5f"><FONT COLOR="white"><FONT POINT-SIZE="9">&lt;&lt;enumeration&gt;&gt;</FONT><BR/><B>RoleCabinet</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">AdministrateurCabinet<BR ALIGN="LEFT"/>ConsultantReferent<BR ALIGN="LEFT"/>ConsultantContributeur<BR ALIGN="LEFT"/>ConsultantLecteur<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
        Mandat [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#00370B"><FONT COLOR="white"><B>Mandat</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+Guid Id<BR ALIGN="LEFT"/>+Guid OrganisationId<BR ALIGN="LEFT"/>+Guid CabinetId<BR ALIGN="LEFT"/>+NiveauMandat Niveau<BR ALIGN="LEFT"/>+PorteeMandat Portee<BR ALIGN="LEFT"/>+List&lt;Guid&gt; ServicesOuEntites<BR ALIGN="LEFT"/>+DateOnly DateDebut<BR ALIGN="LEFT"/>+DateOnly? DateFin<BR ALIGN="LEFT"/>+StatutMandat Statut<BR ALIGN="LEFT"/>+Set&lt;ActionReservable&gt; ActionsReservees<BR ALIGN="LEFT"/>+Guid? AccepteParId<BR ALIGN="LEFT"/>+DateTimeOffset? AccepteLe<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
        NiveauMandat [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#5b6b5f"><FONT COLOR="white"><FONT POINT-SIZE="9">&lt;&lt;enumeration&gt;&gt;</FONT><BR/><B>NiveauMandat</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Consultation<BR ALIGN="LEFT"/>Contribution<BR ALIGN="LEFT"/>PilotageComplet<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
        ActionReservable [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#5b6b5f"><FONT COLOR="white"><FONT POINT-SIZE="9">&lt;&lt;enumeration&gt;&gt;</FONT><BR/><B>ActionReservable</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">VisaAvantDepot<BR ALIGN="LEFT"/>NotificationViolation<BR ALIGN="LEFT"/>RevocationMandat<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
        AffectationConsultant [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#00370B"><FONT COLOR="white"><B>AffectationConsultant</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+Guid MandatId<BR ALIGN="LEFT"/>+Guid UtilisateurId<BR ALIGN="LEFT"/>+bool OpposeeParOrganisation<BR ALIGN="LEFT"/>+DateTimeOffset AffecteLe<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
        StatutMandat [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#5b6b5f"><FONT COLOR="white"><FONT POINT-SIZE="9">&lt;&lt;enumeration&gt;&gt;</FONT><BR/><B>StatutMandat</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Demande<BR ALIGN="LEFT"/>Accepte<BR ALIGN="LEFT"/>Refuse<BR ALIGN="LEFT"/>Actif<BR ALIGN="LEFT"/>Suspendu<BR ALIGN="LEFT"/>Revoque<BR ALIGN="LEFT"/>Expire<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
        PorteeMandat [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#5b6b5f"><FONT COLOR="white"><FONT POINT-SIZE="9">&lt;&lt;enumeration&gt;&gt;</FONT><BR/><B>PorteeMandat</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">TouteLOrganisation<BR ALIGN="LEFT"/>ServicesOuDirections<BR ALIGN="LEFT"/>EntitesDuGroupe<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
        StatutCorrespondant [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#5b6b5f"><FONT COLOR="white"><FONT POINT-SIZE="9">&lt;&lt;enumeration&gt;&gt;</FONT><BR/><B>StatutCorrespondant</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Interne<BR ALIGN="LEFT"/>Externe<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    }
    subgraph cluster_Referentiels {
        label=<<B>Référentiels de juridiction</B>>; fontsize=16; fontcolor="#00370B";
        style="rounded,filled"; fillcolor="#EAF5EC"; color="#8fa596"; margin=18;
        Juridiction [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#00370B"><FONT COLOR="white"><B>Juridiction</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+string Code<BR ALIGN="LEFT"/>+string Nom<BR ALIGN="LEFT"/>+string NomOfficiel<BR ALIGN="LEFT"/>+string Langue<BR ALIGN="LEFT"/>+string SocleRegional<BR ALIGN="LEFT"/>+bool HeriteDuSocle<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
        ReferentielVersion [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#00370B"><FONT COLOR="white"><B>ReferentielVersion</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+Guid Id<BR ALIGN="LEFT"/>+string JuridictionCode<BR ALIGN="LEFT"/>+string Numero<BR ALIGN="LEFT"/>+StatutReferentiel Statut<BR ALIGN="LEFT"/>+DateOnly DateVersion<BR ALIGN="LEFT"/>+DateTimeOffset? PublieLe<BR ALIGN="LEFT"/>+string Avertissement<BR ALIGN="LEFT"/>+JsonDocument Contenu<BR ALIGN="LEFT"/>+string Empreinte<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
        StatutReferentiel [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#5b6b5f"><FONT COLOR="white"><FONT POINT-SIZE="9">&lt;&lt;enumeration&gt;&gt;</FONT><BR/><B>StatutReferentiel</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Brouillon<BR ALIGN="LEFT"/>EnSimulation<BR ALIGN="LEFT"/>Publie<BR ALIGN="LEFT"/>Remplace<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
        Referentiel [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#00370B"><FONT COLOR="white"><B>Referentiel</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+Sources Sources<BR ALIGN="LEFT"/>+ParametresAutorite Autorite<BR ALIGN="LEFT"/>+Dictionary&lt;string,string&gt; Terminologie<BR ALIGN="LEFT"/>+List&lt;Regime&gt; Regimes<BR ALIGN="LEFT"/>+Logigramme Logigramme<BR ALIGN="LEFT"/>+Dictionary&lt;string,List&lt;EtapeFeuilleDeRoute&gt;&gt; FeuillesDeRoute<BR ALIGN="LEFT"/>+ConfigAipd Aipd<BR ALIGN="LEFT"/>+ConfigViolation Violations<BR ALIGN="LEFT"/>+ConfigCorrespondant Correspondant<BR ALIGN="LEFT"/>+ConfigTransferts Transferts<BR ALIGN="LEFT"/>+ConfigIndice Indice<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
        Regime [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#00370B"><FONT COLOR="white"><B>Regime</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+string Id<BR ALIGN="LEFT"/>+string Libelle<BR ALIGN="LEFT"/>+string IntituleOfficiel<BR ALIGN="LEFT"/>+string FamilleCouleur<BR ALIGN="LEFT"/>+int Ordre<BR ALIGN="LEFT"/>+string Fondement<BR ALIGN="LEFT"/>+bool EstUnRegimeDeFormalite<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
        Logigramme [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#00370B"><FONT COLOR="white"><B>Logigramme</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+string Entree<BR ALIGN="LEFT"/>+string Principe<BR ALIGN="LEFT"/>+List&lt;Question&gt; Questions<BR ALIGN="LEFT"/>+List&lt;RegleTransverse&gt; ReglesTransverses<BR ALIGN="LEFT"/>+EcartTextePratique? Ecart<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
        Question [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#00370B"><FONT COLOR="white"><B>Question</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+string Id<BR ALIGN="LEFT"/>+int Ordre<BR ALIGN="LEFT"/>+string Libelle<BR ALIGN="LEFT"/>+string Champ<BR ALIGN="LEFT"/>+TypeQuestion Type<BR ALIGN="LEFT"/>+List&lt;string&gt; Options<BR ALIGN="LEFT"/>+string AideId<BR ALIGN="LEFT"/>+string Fondement<BR ALIGN="LEFT"/>+ConditionBloquante? ConditionBloquante<BR ALIGN="LEFT"/>+Branche Oui<BR ALIGN="LEFT"/>+Branche Non<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
        Branche [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#00370B"><FONT COLOR="white"><B>Branche</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+TypeBranche Type<BR ALIGN="LEFT"/>+string Cible<BR ALIGN="LEFT"/>+string? Motif<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
        TypeBranche [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#5b6b5f"><FONT COLOR="white"><FONT POINT-SIZE="9">&lt;&lt;enumeration&gt;&gt;</FONT><BR/><B>TypeBranche</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Question<BR ALIGN="LEFT"/>Sortie<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
        ConditionBloquante [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#00370B"><FONT COLOR="white"><B>ConditionBloquante</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+string Champ<BR ALIGN="LEFT"/>+JsonElement Valeur<BR ALIGN="LEFT"/>+string Effet<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
        RegleTransverse [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#00370B"><FONT COLOR="white"><B>RegleTransverse</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+string Id<BR ALIGN="LEFT"/>+string Libelle<BR ALIGN="LEFT"/>+string Fondement<BR ALIGN="LEFT"/>+string Regle<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
        EtapeFeuilleDeRoute [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#00370B"><FONT COLOR="white"><B>EtapeFeuilleDeRoute</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+int Ordre<BR ALIGN="LEFT"/>+string Etape<BR ALIGN="LEFT"/>+List&lt;string&gt; Pieces<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
        ParametresAutorite [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#00370B"><FONT COLOR="white"><B>ParametresAutorite</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+string Denomination<BR ALIGN="LEFT"/>+string Sigle<BR ALIGN="LEFT"/>+List&lt;ModaliteDepot&gt; ModalitesDepot<BR ALIGN="LEFT"/>+List&lt;DelaiInstruction&gt; DelaisInstruction<BR ALIGN="LEFT"/>+bool SilenceVautAcceptation<BR ALIGN="LEFT"/>+int? ValiditeDecisionMois<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
        DelaiInstruction [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#00370B"><FONT COLOR="white"><B>DelaiInstruction</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+string Regime<BR ALIGN="LEFT"/>+string? Delai<BR ALIGN="LEFT"/>+string? Prorogeable<BR ALIGN="LEFT"/>+string? Condition<BR ALIGN="LEFT"/>+string Fondement<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
        ConfigAipd [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#00370B"><FONT COLOR="white"><B>ConfigAipd</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+List&lt;CritereAipd&gt; Criteres<BR ALIGN="LEFT"/>+List&lt;string&gt; PresomptionRegimes<BR ALIGN="LEFT"/>+ConsultationPrealable? Consultation<BR ALIGN="LEFT"/>+List&lt;SectionGrille&gt; Grille<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
        CritereAipd [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#00370B"><FONT COLOR="white"><B>CritereAipd</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+string Id<BR ALIGN="LEFT"/>+string Libelle<BR ALIGN="LEFT"/>+string Champ<BR ALIGN="LEFT"/>+decimal? Seuil<BR ALIGN="LEFT"/>+string Source<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
        ConfigViolation [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#00370B"><FONT COLOR="white"><B>ConfigViolation</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+int DelaiNotificationHeures<BR ALIGN="LEFT"/>+string PointDeDepart<BR ALIGN="LEFT"/>+string Destinataire<BR ALIGN="LEFT"/>+List&lt;NoeudViolation&gt; Arbre<BR ALIGN="LEFT"/>+List&lt;decimal&gt; RappelsProportionDelai<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
        NoeudViolation [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#00370B"><FONT COLOR="white"><B>NoeudViolation</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+string Id<BR ALIGN="LEFT"/>+string Libelle<BR ALIGN="LEFT"/>+BrancheViolation Oui<BR ALIGN="LEFT"/>+BrancheViolation Non<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
        ConfigIndice [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#00370B"><FONT COLOR="white"><B>ConfigIndice</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+List&lt;ComposanteIndice&gt; Composantes<BR ALIGN="LEFT"/>+List&lt;SeuilIndice&gt; Seuils<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
        DefinitionChamp [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#00370B"><FONT COLOR="white"><B>DefinitionChamp</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+string Id<BR ALIGN="LEFT"/>+NiveauChamp Niveau<BR ALIGN="LEFT"/>+string Bloc<BR ALIGN="LEFT"/>+string LibelleAffiche<BR ALIGN="LEFT"/>+TypeChamp Type<BR ALIGN="LEFT"/>+List&lt;string&gt; Valeurs<BR ALIGN="LEFT"/>+string Juridiction<BR ALIGN="LEFT"/>+bool AlimenteMoteur<BR ALIGN="LEFT"/>+string RubriqueSocle<BR ALIGN="LEFT"/>+string? AideId<BR ALIGN="LEFT"/>+bool ExportRegistre<BR ALIGN="LEFT"/>+string? Note<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
        ExigenceChamp [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#00370B"><FONT COLOR="white"><B>ExigenceChamp</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+string ChampId<BR ALIGN="LEFT"/>+string JuridictionCode<BR ALIGN="LEFT"/>+Exigence Niveau<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
        Exigence [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#5b6b5f"><FONT COLOR="white"><FONT POINT-SIZE="9">&lt;&lt;enumeration&gt;&gt;</FONT><BR/><B>Exigence</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Obligatoire<BR ALIGN="LEFT"/>Recommande<BR ALIGN="LEFT"/>Conditionnel<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
        BulleInformation [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#00370B"><FONT COLOR="white"><B>BulleInformation</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+string Id<BR ALIGN="LEFT"/>+string? JuridictionCode<BR ALIGN="LEFT"/>+string Titre<BR ALIGN="LEFT"/>+string Texte<BR ALIGN="LEFT"/>+string? LienFiche<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
        TypeQuestion [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#5b6b5f"><FONT COLOR="white"><FONT POINT-SIZE="9">&lt;&lt;enumeration&gt;&gt;</FONT><BR/><B>TypeQuestion</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Booleen<BR ALIGN="LEFT"/>Multiple<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
        NiveauChamp [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#5b6b5f"><FONT COLOR="white"><FONT POINT-SIZE="9">&lt;&lt;enumeration&gt;&gt;</FONT><BR/><B>NiveauChamp</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Organisation<BR ALIGN="LEFT"/>Traitement<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
        TypeChamp [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#5b6b5f"><FONT COLOR="white"><FONT POINT-SIZE="9">&lt;&lt;enumeration&gt;&gt;</FONT><BR/><B>TypeChamp</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Texte<BR ALIGN="LEFT"/>TexteLong<BR ALIGN="LEFT"/>Booleen<BR ALIGN="LEFT"/>Date<BR ALIGN="LEFT"/>Liste<BR ALIGN="LEFT"/>ListeMultiple<BR ALIGN="LEFT"/>Tranche<BR ALIGN="LEFT"/>Tableau<BR ALIGN="LEFT"/>Fichier<BR ALIGN="LEFT"/>Fichiers<BR ALIGN="LEFT"/>Courriel<BR ALIGN="LEFT"/>Telephone<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
        Sources [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#00370B"><FONT COLOR="white"><B>Sources</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+TextePrincipal TextePrincipal<BR ALIGN="LEFT"/>+string EtatTextesApplication<BR ALIGN="LEFT"/>+List&lt;ArticleCle&gt; ArticlesCles<BR ALIGN="LEFT"/>+List&lt;string&gt; DoctrineAutorite<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
        ArticleCle [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#00370B"><FONT COLOR="white"><B>ArticleCle</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+string Art<BR ALIGN="LEFT"/>+string Objet<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
        ModaliteDepot [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#00370B"><FONT COLOR="white"><B>ModaliteDepot</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+string Canal<BR ALIGN="LEFT"/>+string? Fondement<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
        EcartTextePratique [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#00370B"><FONT COLOR="white"><B>EcartTextePratique</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+List&lt;string&gt; SortiesConcernees<BR ALIGN="LEFT"/>+string Constat<BR ALIGN="LEFT"/>+string RegleAffichage<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
